{
  "cli": {
    "version": ">= 16.22.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "channel": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "environment": "preview",
      "channel": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6761799123",
        "appleTeamId": "UTS33LWLQV"
      }
    },
    "production": {
      "ios": {},
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
